{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specification-metrics:candidate-classification-suggestions:1",
  "title": "SpecificationMetrics candidate classification suggestions v1",
  "description": "Informational model suggestions. This artifact does not update the reviewed registry or S/U metric.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "run_id",
    "generated_at",
    "source",
    "rubric",
    "architecture_profile",
    "provider",
    "suggestions"
  ],
  "properties": {
    "artifact_kind": {"const": "candidate_classification_suggestions"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "rubric": {"$ref": "#/$defs/rubric"},
    "architecture_profile": {"$ref": "#/$defs/architectureProfile"},
    "provider": {"$ref": "#/$defs/provider"},
    "suggestions": {
      "type": "array",
      "items": {"$ref": "#/$defs/suggestion"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(sha256|blake3):[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "source_digest",
        "scope_manifest_digest",
        "scan_report_digest"
      ],
      "properties": {
        "revision": {"type": ["string", "null"]},
        "source_digest": {"$ref": "#/$defs/digest"},
        "scope_manifest_digest": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "scan_report_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "architectureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "endpoint",
        "requested_model",
        "returned_models",
        "adapter_version",
        "prompt_digest",
        "inference_config_digest",
        "inference_parameters",
        "data_boundary",
        "usage"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri"},
        "requested_model": {"type": "string", "minLength": 1},
        "returned_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "adapter_version": {"type": "string", "minLength": 1},
        "prompt_digest": {"$ref": "#/$defs/digest"},
        "inference_config_digest": {"$ref": "#/$defs/digest"},
        "inference_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "top_p",
            "max_output_tokens",
            "min_confidence",
            "timeout_seconds",
            "provider_options_digest"
          ],
          "properties": {
            "temperature": {"type": ["number", "null"]},
            "top_p": {"type": ["number", "null"]},
            "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
            "min_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "provider_options_digest": {
              "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
            }
          }
        },
        "data_boundary": {"enum": ["local", "hosted"]},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_fingerprint",
        "context_digest",
        "model_id",
        "model_revision",
        "cacheable",
        "opportunity",
        "concern_kind",
        "diagnostics",
        "opportunity_rationale",
        "concern_rationale",
        "provider_scores",
        "score_semantics"
      ],
      "properties": {
        "candidate_fingerprint": {"type": "string", "minLength": 1},
        "context_digest": {"$ref": "#/$defs/digest"},
        "model_id": {"type": ["string", "null"]},
        "model_revision": {"type": ["string", "null"]},
        "cacheable": {"type": "boolean"},
        "opportunity": {"enum": ["eligible", "excluded", "needs_review"]},
        "concern_kind": {
          "enum": ["policy", "mechanics", "variant_behavior", "unknown"]
        },
        "diagnostics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["provider_error", "malformed_provider_output", "close_decision"]
          }
        },
        "opportunity_rationale": {"$ref": "#/$defs/rationale"},
        "concern_rationale": {"$ref": "#/$defs/rationale"},
        "provider_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opportunity", "concern_kind"],
          "properties": {
            "opportunity": {
              "oneOf": [{"$ref": "#/$defs/choiceScores"}, {"type": "null"}]
            },
            "concern_kind": {
              "oneOf": [{"$ref": "#/$defs/choiceScores"}, {"type": "null"}]
            }
          }
        },
        "score_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opportunity", "concern_kind"],
          "properties": {
            "opportunity": {"type": ["string", "null"]},
            "concern_kind": {"type": ["string", "null"]}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"cacheable": {"const": true}},
            "required": ["cacheable"]
          },
          "then": {
            "properties": {
              "model_revision": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_scores": {
                "properties": {"opportunity": {"type": "object"}}
              }
            }
          },
          "then": {
            "properties": {
              "score_semantics": {
                "properties": {"opportunity": {"type": "string", "minLength": 1}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider_scores": {
                "properties": {"concern_kind": {"type": "object"}}
              }
            }
          },
          "then": {
            "properties": {
              "score_semantics": {
                "properties": {"concern_kind": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      ]
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source"],
      "properties": {
        "text": {"type": ["string", "null"], "maxLength": 500},
        "source": {"enum": ["provider", "adapter", "unavailable"]}
      }
    },
    "choiceScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probabilities", "confidence"],
      "properties": {
        "probabilities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}
