      ],
      "file_sha256": "3dd63737b8c3a32a4ea5d4c790dd30d6ee8b9f27de0cb0ddfc2de395ff61a827",
      "code": "class BDDPolicy(Specification[BDDContext]):\n    spec_id = \"SG-SPEC-0070\"\n    rule_ref: str\n\n    def __init__(self) -> None:\n        super().__init__(name=self.rule_ref)\n        self._seal()\n\n    def findings(self, context: BDDContext) -> tuple[BDDScenarioFinding, ...]:\n        raise NotImplementedError",
      "excerpt_sha256": "52c0eff0ef4e80873296c687f1b4a52c470a08e5201cdd846184b6a967022882"
    },
    "implementation_evaluator": {
      "path": "tools/native_bdd/policy.py",
      "lines": [
        31,
        32
      ],
      "file_sha256": "3dd63737b8c3a32a4ea5d4c790dd30d6ee8b9f27de0cb0ddfc2de395ff61a827",
      "code": "    def _evaluate(self, candidate: BDDContext, recorder: TraceRecorder | None) -> bool:\n        return not self.findings(candidate)",
      "excerpt_sha256": "52f8414efc1336c5146f32dcd84720c047468aea553d05ac290362b8cb1a6b16"
    },
    "composition_membership": {
      "path": "tools/native_bdd/composition.py",
      "lines": [
        13,
        20
      ],
      "file_sha256": "a7c9a90bd105417079e200106da909f3437e183c415ea4a544b62c7fdd7bb753",
      "code": "POLICIES = (\n    BDDProfileSelectionSpec(),\n    BDDContainerPresenceSpec(),\n    BDDScenarioFieldsSpec(),\n    BDDScenarioValuesSpec(),\n    BDDScenarioIDsSpec(),\n    BDDScenarioReferencesSpec(),\n)",
      "excerpt_sha256": "4c37d5588f6c62361de808a0c9487fee830f35a4ee950191f4883ab5a2766270"
    },
    "composition_evaluation": {
      "path": "tools/native_bdd/composition.py",
      "lines": [
        28,
        39
      ],
      "file_sha256": "a7c9a90bd105417079e200106da909f3437e183c415ea4a544b62c7fdd7bb753",
      "code": "    for policy in POLICIES:\n        skip = policy.skip_reason(context)\n        if skip:\n            if recorder is not None:\n                recorder.skipped(policy.rule_ref)\n            outcomes.append(PolicyOutcome(policy.rule_ref, \"skipped\", skip))\n            continue\n        passed = policy.is_satisfied_by(context, recorder=recorder)\n        current_findings = policy.findings(context)\n        findings.extend(current_findings)\n        outcomes.append(PolicyOutcome(policy.rule_ref, \"satisfied\" if passed else \"unsatisfied\"))\n        context = policy.transition(context, current_findings)",
      "excerpt_sha256": "410d04f54fbc1a65c17bc2eb52609bff711416c2d66c48f4e820fc49c2969bb2"
    },
    "implementation_values_class": {
      "path": "tools/native_bdd/values_spec.py",
      "lines": [
        7,
        29
      ],
      "file_sha256": "1c7509f9beef4d79511d5e6ad1fcf94a1d217ef74f7c55d3e31594ae166b49e8",
      "code": "class BDDScenarioValuesSpec(BDDPolicy):\n    rule_ref = \"SG-RFC-0223.native.scenario-values\"\n\n    def skip_reason(self, context: BDDContext) -> str | None:\n        return super().skip_reason(context) or entry_skip(context)\n\n    def findings(self, context: BDDContext):\n        findings = []\n        for index, entry in enumerate(context.entries):\n            if not entry.is_mapping:\n                continue\n            path = f\"specification.bdd_scenarios[{index}]\"\n            if not entry.id.valid:\n                findings.append(issue(\"invalid_value\", path + \".id\"))\n            if not entry.steps_is_list or not entry.steps:\n                findings.append(issue(\"invalid_value\", path + \".steps\"))\n            else:\n                findings.extend(\n                    issue(\"invalid_value\", f\"{path}.steps[{i}]\")\n                    for i, step in enumerate(entry.steps)\n                    if not step.valid\n                )\n        return tuple(findings)",
      "excerpt_sha256": "fb0e0299e993c10f1fff92a083d7ccd6ed1dfd23bf0adbedac007f2ab317e38e"
    },
    "implementation_fields_class": {
      "path": "tools/native_bdd/fields_spec.py",
      "lines": [
        7,
        25
      ],
      "file_sha256": "e7b8600deeebb0f68284213a8fd8894cb9f4f52c53d359b8112f968c72950f59",
      "code": "class BDDScenarioFieldsSpec(BDDPolicy):\n    rule_ref = \"SG-RFC-0223.native.scenario-fields\"\n\n    def skip_reason(self, context: BDDContext) -> str | None:\n        return super().skip_reason(context) or entry_skip(context)\n\n    def findings(self, context: BDDContext):\n        findings = []\n        for index, entry in enumerate(context.entries):\n            path = f\"specification.bdd_scenarios[{index}]\"\n            if not entry.is_mapping:\n                findings.append(issue(\"invalid_entry\", path))\n                continue\n            if entry.title_supplied and not entry.title.valid:\n                findings.append(issue(\"invalid_value\", path + \".scenario\"))\n            findings.extend(\n                issue(\"unsupported_field\", path + \".\" + key) for key in entry.unknown_fields\n            )\n        return tuple(findings)",
      "excerpt_sha256": "15131b99f42758dd1c791f1e0b3a35e15f02f2e0c1667d22021fdb22bc0a6b97"
    }
  },
