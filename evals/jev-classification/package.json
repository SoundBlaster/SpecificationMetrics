{
  "private": true,
  "name": "specificationmetrics-jev-classification-eval",
  "version": "0.1.0",
  "description": "Opt-in Promptfoo evaluation for Jev candidate classification",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "eval": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c promptfooconfig.yaml",
    "eval:fresh": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c promptfooconfig.yaml --no-cache",
    "validate": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo validate config -c promptfooconfig.yaml",
    "test:offline": "node --test providers/jev.test.mjs",
    "view": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo view"
  },
  "devDependencies": {
    "promptfoo": "0.123.1"
  }
}
